{
  "name": "travessia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev:web": "npm run dev --workspace @travessia/web",
    "dev:api": "npm run dev --workspace @travessia/api",
    "build": "npm run build --workspace @travessia/api && npm run build --workspace @travessia/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.ts",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check": "npm run check:foundation && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
