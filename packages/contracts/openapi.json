{
  "openapi": "3.1.0",
  "info": {
    "title": "Travessia API",
    "version": "0.1.0",
    "description": "Base inicial. Somente health está implementado; demais operações estão em docs/API.md."
  },
  "servers": [
    {
      "url": "http://localhost:3001/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "stage"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "travessia-api"
          },
          "stage": {
            "const": "foundation"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
