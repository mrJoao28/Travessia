generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  preferences   ReadingPreferences?
  memberships   Membership[]
  submissions   Submission[]
  barriers      BarrierReport[]
  generations   AiGeneration[]
  strategyRecipients StrategyRecipient[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Profile {
  userId String @id
  phone String? @db.VarChar(30)
  alternateEmail String? @db.VarChar(150)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  userId String @id
  registration String? @db.VarChar(50)
  institution String? @db.VarChar(80)
  unit String? @db.VarChar(150)
  course String?
  period String? @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  userId String @id
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachings TeachingAssignment[]
}

// Self-described academic information; never grants a classroom membership.
model TeachingAssignment {
  id String @id @default(uuid())
  teacherId String
  subject String @db.VarChar(150)
  course String @db.VarChar(150)
  position Int
  teacher TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  @@unique([teacherId, subject, course])
  @@unique([teacherId, position])
}

model ReadingPreferences {
  userId String @id
  fontSize String @default("default")
  spacing String @default("default")
  contrast String @default("default")
  reducedDistractions Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  student
  teacher
}
enum MissionStatus {
  draft
  published
  archived
}
enum SubmissionStatus {
  draft
  submitted
  reviewed
}
enum GenerationStatus {
  running
  succeeded
  failed
  cancelled
}
enum FileStatus {
  quarantined
  verified
  rejected
}

model Classroom {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  memberships Membership[]
  invitations Invitation[]
  missions Mission[]
}
model Membership {
  id String @id @default(uuid())
  userId String
  classroomId String
  role Role
  active Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  @@unique([userId, classroomId])
  @@index([classroomId, active])
}
model Invitation {
  id String @id @default(uuid())
  classroomId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  consumedAt DateTime?
  consumedBy String?
  createdAt DateTime @default(now())
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  @@index([classroomId])
}
model Mission {
  id String @id @default(uuid())
  classroomId String
  status MissionStatus @default(draft)
  draftVersionId String? @unique
  publishedVersionId String? @unique
  createdAt DateTime @default(now())
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  versions MissionVersion[] @relation("versions")
  draftVersion MissionVersion? @relation("draft", fields: [draftVersionId], references: [id])
  publishedVersion MissionVersion? @relation("published", fields: [publishedVersionId], references: [id])
  @@index([classroomId, status])
}
model MissionVersion {
  id String @id @default(uuid())
  missionId String
  title String
  description String
  objectives Json
  criteria Json
  source String @default("manual")
  dueAt DateTime?
  createdAt DateTime @default(now())
  mission Mission @relation("versions", fields: [missionId], references: [id], onDelete: Cascade)
  draftOf Mission? @relation("draft")
  publishedOf Mission? @relation("published")
  steps Step[]
  materials Material[]
  submissions Submission[]
  strategyPlans StrategyPlan[]
  @@index([missionId])
}
model Step {
  id String @id @default(uuid())
  versionId String
  position Int
  title String
  instructions String
  example String
  version MissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  barriers BarrierReport[]
  strategyPlans StrategyPlan[]
  @@unique([versionId, position])
}
model Material {
  id String @id @default(uuid())
  versionId String
  title String
  text String
  storagePath String?
  fileStatus FileStatus @default(quarantined)
  mimeType String?
  sizeBytes Int?
  version MissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@index([versionId])
}
model Submission {
  id String @id @default(uuid())
  versionId String
  userId String
  status SubmissionStatus @default(draft)
  content String
  completedStepIds Json
  currentStepId String
  revision Int @default(1)
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version MissionVersion @relation(fields: [versionId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback Feedback[]
  @@unique([versionId, userId])
  @@index([userId, status])
}
model Feedback {
  id String @id @default(uuid())
  submissionId String
  teacherId String
  content String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@index([submissionId])
}
model BarrierReport {
  id String @id @default(uuid())
  stepId String
  userId String
  description String
  sharedWithTeacher Boolean @default(false)
  response String?
  respondedBy String?
  createdAt DateTime @default(now())
  step Step @relation(fields: [stepId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([stepId, sharedWithTeacher])
}
model AiGeneration {
  id String @id @default(uuid())
  userId String
  classroomId String
  missionId String
  idempotencyKey String
  inputHash String
  status GenerationStatus @default(running)
  attempt Int @default(1)
  model String
  outputVersionId String?
  supportDraft Json?
  inputTokens Int?
  outputTokens Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, missionId, idempotencyKey])
  @@index([userId, classroomId, createdAt])
}
model RateBucket {
  key String @id
  count Int
  expiresAt DateTime
}
model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model DemoDataset {
  id String @id
  anchor DateTime @default(now())
  userId String? @unique
}

model StrategyPlan {
  id String @id @default(uuid())
  versionId String
  stepId String?
  audience String
  revision Int @default(1)
  requestKey String
  requestHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version MissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  step Step? @relation(fields: [stepId], references: [id], onDelete: Cascade)
  items StrategyItem[]
  recipients StrategyRecipient[]
  @@unique([versionId, requestKey])
  @@index([versionId, stepId])
}
model StrategyItem {
  id String @id @default(uuid())
  planId String
  strategyId String
  title String
  content String
  position Int
  audio Bytes?
  hasAudio Boolean @default(false)
  plan StrategyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, strategyId])
  @@unique([planId, position])
}
model StrategyRecipient {
  planId String
  userId String
  plan StrategyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([planId, userId])
  @@index([userId])
}
