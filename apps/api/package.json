{
  "name": "@travessia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx src/seed-cli.ts",
    "test:http": "tsx --test tests/http.test.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.14",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "playwright-core": "1.56.1",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
