# npm run docker:setup cria .env.docker com segredos aleatórios; não versionar esse arquivo.
APP_PUBLIC_ORIGIN=http://localhost:3000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
ALLOW_LOCAL_HTTP=true
POSTGRES_USER=travessia
POSTGRES_DB=travessia
POSTGRES_PASSWORD=replace-me
DATABASE_URL=replace-me
BETTER_AUTH_SECRET=replace-me
# Banco dedicado somente à demonstração local. Cadastro público fechado.
DEMO_MODE=true
DEMO_ONLY=true
DEMO_USER_EMAIL=demo@example.invalid
DEMO_USER_PASSWORD=replace-me
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PUBLIC_USE_APPROVED=false
SUPABASE_URL=
SUPABASE_STORAGE_SECRET=
